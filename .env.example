# InboxShield AI configuration (copy to .env and edit; never commit .env)
# All values are optional except where noted. No cloud AI provider is used.

# Local Ollama endpoint and vision model
INBOXSHIELD_OLLAMA_URL=http://localhost:11434
INBOXSHIELD_MODEL=gemma4:e2b
INBOXSHIELD_OLLAMA_TIMEOUT=600
INBOXSHIELD_TEMPERATURE=0.0
INBOXSHIELD_MAX_PDF_PAGES=3

# Directories (absolute or relative to the project root)
INBOXSHIELD_INCOMING_DIR=incoming_invoices
INBOXSHIELD_PROCESSED_DIR=processed_invoices
INBOXSHIELD_DATA_DIR=data
INBOXSHIELD_LOG_DIR=logs
INBOXSHIELD_DB_PATH=data/inboxshield.db

# Ingestion safety and processing
INBOXSHIELD_MAX_FILE_SIZE_MB=20
INBOXSHIELD_STABLE_SECONDS=1.5
INBOXSHIELD_STABLE_TIMEOUT=30
INBOXSHIELD_MAX_RETRIES=3
INBOXSHIELD_RETRY_BACKOFF=5
INBOXSHIELD_WORKERS=1
INBOXSHIELD_RECONCILE_INTERVAL=60
INBOXSHIELD_HEARTBEAT_INTERVAL=10
INBOXSHIELD_ARCHIVE_FILES=true

# Audit thresholds
INBOXSHIELD_DUPLICATE_WINDOW_DAYS=30
INBOXSHIELD_VENDOR_SIMILARITY=0.86
INBOXSHIELD_AMOUNT_TOLERANCE_MINOR=0
INBOXSHIELD_BASE_CURRENCY=GHS
INBOXSHIELD_SUPPORTED_CURRENCIES=GHS,USD,EUR,GBP,NGN,ZAR,KES,XOF,CAD,AUD,INR,CNY,JPY,CHF,AED

# Dashboard
INBOXSHIELD_DASHBOARD_REFRESH=5
INBOXSHIELD_PAGE_SIZE=25

# Logging
INBOXSHIELD_LOG_LEVEL=INFO
INBOXSHIELD_ENV=production

# Optional IMAP ingestion (disabled unless explicitly enabled and implemented)
# Credentials belong in .env only; never commit them.
INBOXSHIELD_IMAP_ENABLED=false
INBOXSHIELD_IMAP_HOST=
INBOXSHIELD_IMAP_PORT=993
INBOXSHIELD_IMAP_USE_TLS=true
INBOXSHIELD_IMAP_USERNAME=
INBOXSHIELD_IMAP_PASSWORD=
INBOXSHIELD_IMAP_FOLDER=INBOX
INBOXSHIELD_IMAP_POLL_SECONDS=300
